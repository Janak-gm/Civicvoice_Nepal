services:
  - type: web
    name: civicvoice-backend
    runtime: python
    repo: https://github.com/Janak-gm/Civicvoice_Nepal
    buildCommand: cd CivicVoice_backend && pip install -r requirements.txt && python manage.py migrate && python manage.py collectstatic --noinput && python manage.py ensure_admin
    startCommand: cd CivicVoice_backend && daphne -b 0.0.0.0 -p $PORT config.asgi:application
    envVars:
      - key: DJANGO_SECRET_KEY
        generateValue: true
      - key: DJANGO_DEBUG
        value: False
      - key: DJANGO_ALLOWED_HOSTS
        value: .onrender.com,localhost
      - key: CORS_ALLOWED_ORIGINS
        value: http://localhost:3000,https://civicvoice-frontend.vercel.app,https://civicvoice-nepal.onrender.com
      - key: CSRF_TRUSTED_ORIGINS
        value: https://civicvoice-nepal.onrender.com,https://civicvoice-frontend.vercel.app
      - key: DB_NAME
        fromDatabase:
          name: civicvoice-db
          property: database
      - key: DB_USER
        fromDatabase:
          name: civicvoice-db
          property: user
      - key: DB_PASSWORD
        fromDatabase:
          name: civicvoice-db
          property: password
      - key: DB_HOST
        fromDatabase:
          name: civicvoice-db
          property: host
      - key: DB_PORT
        fromDatabase:
          name: civicvoice-db
          property: port
      - key: CLOUDINARY_CLOUD_NAME
        value: your_cloud_name
      - key: CLOUDINARY_API_KEY
        value: your_api_key
      - key: CLOUDINARY_API_SECRET
        value: your_api_secret
      - key: DJANGO_SUPERUSER_USERNAME
        value: admin
      - key: DJANGO_SUPERUSER_EMAIL
        value: admin@civicvoice.com
      - key: DJANGO_SUPERUSER_PASSWORD
        value: your_secure_password

databases:
  - name: civicvoice-db
    plan: free
